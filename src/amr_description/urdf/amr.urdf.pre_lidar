<?xml version="1.0"?>

<robot name="amr">

  <!-- ========================= -->
  <!-- BASE / CHASSIS            -->
  <!-- ========================= -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="1.0 0.6 0.3"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="1.0 0.6 0.3"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="10"/>
      <inertia
        ixx="0.72"
        ixy="0"
        ixz="0"
        iyy="1.0"
        iyz="0"
        izz="1.0"/>
    </inertial>
  </link>


  <!-- ========================= -->
  <!-- LEFT WHEEL                -->
  <!-- ========================= -->

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1"/>
      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.01"
        iyz="0"
        izz="0.01"/>
    </inertial>
  </link>


  <joint name="left_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel"/>

    <origin xyz="0 0.34 0.15"
            rpy="1.5708 0 0"/>

    <axis xyz="0 0 1"/>

  </joint>


  <!-- ========================= -->
  <!-- RIGHT WHEEL               -->
  <!-- ========================= -->

  <link name="right_wheel">

    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1"/>
      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.01"
        iyz="0"
        izz="0.01"/>
    </inertial>

  </link>


  <joint name="right_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel"/>

    <origin xyz="0 -0.34 0.15"
            rpy="1.5708 0 0"/>

    <axis xyz="0 0 1"/>

  </joint>

  //added code
  //start
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.68</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/model/amr/odometry</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>
  //end
  //added code 


</robot>
